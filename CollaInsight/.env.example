# CollaInsight local n8n environment (Phase 1: workflow validation only).
# Copy this file to `.env` and fill in real values. Never commit `.env` itself
# (it's already covered by .gitignore's generic `.env` pattern).

# --- Credential encryption ---
# Generate once with: openssl rand -hex 32
# Back this up somewhere outside the repo. If it changes or is lost, every
# credential saved inside n8n (Telegram bot token, LLM API key, etc., once
# those are added in a later phase) becomes permanently unrecoverable.
N8N_ENCRYPTION_KEY=

# --- Timezone ---
# IANA timezone name, e.g. Asia/Riyadh, Europe/Berlin, America/New_York.
# Affects Schedule Trigger nodes and displayed timestamps.
GENERIC_TIMEZONE=UTC
TZ=UTC

# --- Networking ---
N8N_HOST=localhost
N8N_HOST_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
# Public URL Telegram's webhook actually hits. Set this to
# https://<your NGROK_DOMAIN below>/ (with trailing slash) once you have
# your ngrok static domain - it's stable across restarts, so unlike the
# Cloudflare Quick Tunnel this used to point at, you only set it once.
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Runtime / security hardening ---
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# --- Public tunnel (ngrok) ---
# Free plan includes one persistent static domain per account, so the URL
# doesn't change across restarts. One-time setup:
#   1. Create a free account at https://dashboard.ngrok.com/signup
#   2. Copy your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
#   3. Reserve your free static domain at
#      https://dashboard.ngrok.com/domains ("+ New Domain" - it's free,
#      looks like <random-words>.ngrok-free.app or similar)
#   4. Paste both below, set N8N_WEBHOOK_URL above to https://<that-domain>/,
#      then `docker compose up -d`.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- Public tunnel (Cloudflare Quick Tunnel) - fallback, not in use ---
# Free, no account/domain needed, but its trycloudflare.com URL changes on
# every restart. If you switch back to this (see docker-compose.yml's
# commented-out `cloudflared` service), run
# `bash scripts/sync-quick-tunnel.sh` instead of `docker compose up -d` -
# it detects the new URL and writes it into N8N_WEBHOOK_URL automatically.

# --- Public tunnel (Tailscale Funnel) - PARKED, do not use ---
# Tried as a stable-URL replacement for the Quick Tunnel above. Parked:
# Tailscale's control plane has a known bug where it reports "Funnel on"
# without ever publishing the public DNS record, so Telegram (or anything
# else external) can't reach it. See docker-compose.yml's commented-out
# `tailscale` service and docs/PROJECT_UNDERSTANDING.md for status if you
# want to retry this later.
TS_AUTHKEY=
TS_HOSTNAME=collainsight-n8n
