    {
      "parameters": {
        "content": "**IDEA AGENT — Implemented for MVP**\nValidates content → calls Python backend `POST /api/idea` → relays the structured JSON reply to Telegram.\n\nAll extraction/dedup/save logic runs in the backend (LangGraph). This branch never touches AI directly.",
        "height": 160,
        "width": 780,
        "color": 3
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1300, -220],
      "id": "c011a000-0000-4000-8000-000000000007",
      "name": "Sticky - Idea Branch Explanation"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            { "id": "3a2b3c4d-0003-4000-8000-000000000001", "leftValue": "={{ $json.idea_text }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1040, 0],
      "id": "c011a000-0000-4000-8000-000000000008",
      "name": "Validate Idea Content"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://YOUR_BACKEND_URL:8000/api/idea",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ telegram_display_name: $json.telegram_display_name, chat_id: $json.chat_id, chat_title: $json.chat_title, message_id: $json.message_id, idea_text: $json.idea_text }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-API-Key", "value": "REPLACE_WITH_BACKEND_API_KEY" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 0],
      "id": "c011a000-0000-4000-8000-000000000009",
      "name": "Call Idea Agent (POST /api/idea)"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const res = $json;\nconst isNew = res.status === 'saved';\nconst text = isNew\n  ? `✅ Idea saved!\\n📌 ${res.title}\\n${res.summary}`\n  : `ℹ️ ${res.title || 'This looks similar to an existing idea'}\\n${res.summary || 'A similar idea already exists — nothing new was saved.'}`;\n\nreturn { json: { reply_text: text, status: res.status, similar_found: res.similar_found } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 0],
      "id": "c011a000-0000-4000-8000-00000000000a",
      "name": "Format Idea Reply"
    },
    {
      "parameters": {
        "chatId": "={{ $('Parse Command').item.json.chat_id }}",
        "text": "={{ $json.reply_text }}",
        "additionalFields": { "appendAttribution": false }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1820, 0],
      "id": "c011a000-0000-4000-8000-00000000000b",
      "name": "Reply - Idea Saved",
      "credentials": {
