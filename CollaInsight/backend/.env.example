# CollaInsight backend PoC - copy to backend/.env and fill in real values.
# Never commit backend/.env itself.

# --- Supabase (PoC project - not the production database) ---
# Create any throwaway Supabase project for this PoC (or reuse a personal
# test one, same pattern as the Week 5 training's DEMO_SUPABASE_URL/KEY) and
# run the poc_ideas table DDL from backend/README.md against it first.
SUPABASE_URL=
SUPABASE_KEY=

# --- Gemini (LLM) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# --- AI-safe read path (ai_readonly role) ---
# Required for BOTH POST /api/insights/chat AND the Idea Agent's
# search_similar_ideas tool (ai/tools.py) - not just Insights AI. Direct
# Postgres connection string for the ai_readonly role - NOT the
# service-role SUPABASE_KEY above. ai_readonly has SELECT granted on the
# ai_knowledge_feed view only (no grants on poc_ideas/poc_questions/etc.),
# so this credential is structurally incapable of reading raw Telegram
# metadata or writing anything. ai_knowledge_feed already exists in
# Supabase; the ai_readonly role itself still needs to be created and
# granted SELECT on it (see backend/README.md's "AI-safe read path"
# section) before either of those will work.
# Format: postgresql://ai_readonly:PASSWORD@HOST:5432/postgres
INSIGHTS_DB_URL=
